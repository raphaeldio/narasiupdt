# Salin ke .env lalu isi. Kunci yang kosong = komponen itu memakai mode lokal.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
# Urutan penyedia LLM (yang gagal/kuota habis otomatis dilewati).
LLM_ORDER=["groq","gemini"]
FACTCHECK_API_KEY=
TAVILY_API_KEY=

# Kosong = cache di memori proses. Contoh Upstash: rediss://default:<token>@<host>:6379
REDIS_URL=

# Origin dashboard Mode Satuan (format JSON).
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
# Bila diisi, dashboard wajib mengirim header X-Dashboard-Token. Wajib diisi di produksi:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
# ID extension NARASI resmi (format JSON). Kosong = semua extension Chrome boleh memanggil API.
EXTENSION_IDS=[]
# Laporan berstatus "ditutup" dihapus otomatis setelah sekian hari. 0 = simpan selamanya.
CLOSED_REPORT_RETENTION_DAYS=90

# Pagar kuota LLM untuk seluruh server (0 = tanpa batas). Bila habis, klaim memakai heuristik.
LLM_MAX_PER_MINUTE=30
LLM_MAX_PER_DAY=5000
# "production" menolak start bila DASHBOARD_TOKEN/VIEWER_SALT kosong atau TESTBED_FIXTURES=true.
ENVIRONMENT=development

# Data uji hanya untuk pengujian otomatis; biarkan false.
TESTBED_FIXTURES=false
