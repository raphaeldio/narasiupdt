# Mode lokal untuk e2e dan uji manual: semua kunci API dikosongkan agar tidak memakai kuota,
# dan laporan disimpan di basis data terpisah dari var/narasi.db.
GEMINI_API_KEY=
GROQ_API_KEY=
FACTCHECK_API_KEY=
TAVILY_API_KEY=
REDIS_URL=
REPORTS_DB_PATH=var/local.db

# Sumber daring tanpa kunci ikut dimatikan agar hasil e2e bisa diulang.
FACT_FEEDS=false
NEWS_SEARCH=false
