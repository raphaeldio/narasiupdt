{"manifest_version":3,"name":"NARASI — Cek Hoaks Video Pendek","description":"Cek hoaks berbasis bukti untuk Instagram Reels, TikTok, YouTube Shorts, dan Facebook Reels (semua topik, termasuk konten berbahasa asing).","version":"0.1.0","icons":{"16":"icon/16.png","32":"icon/32.png","48":"icon/48.png","96":"icon/96.png","128":"icon/128.png"},"permissions":["storage"],"host_permissions":["*://*.instagram.com/*","*://*.tiktok.com/*","*://*.youtube.com/*","*://*.facebook.com/*","http://localhost:8000/*","http://127.0.0.1:8000/*"],"action":{"default_title":"NARASI","default_popup":"popup.html"},"background":{"service_worker":"background.js"},"content_scripts":[{"matches":["*://*.facebook.com/*","*://*.instagram.com/*","*://*.tiktok.com/*","*://*.youtube.com/*"],"run_at":"document_idle","js":["content-scripts/content.js"]}],"web_accessible_resources":[{"resources":["content-scripts/content.css"],"use_dynamic_url":true,"matches":["*://*.facebook.com/*","*://*.instagram.com/*","*://*.tiktok.com/*","*://*.youtube.com/*"]}]}