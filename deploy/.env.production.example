# Salin ke deploy/.env lalu isi. Server menolak start bila nilai wajib kosong (ENVIRONMENT=production).

# --- Wajib ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
# Nilai acak tetap, jangan diubah setelah dipakai.
VIEWER_SALT=
TESTBED_FIXTURES=false
# ID extension NARASI yang dipasang di satuan (lihat chrome://extensions), format JSON.
EXTENSION_IDS=[]
CORS_ORIGINS=[]

# --- Layanan berkuota (kosong = komponen itu memakai mode lokal tanpa kuota) ---
GROQ_API_KEY=
GEMINI_API_KEY=
FACTCHECK_API_KEY=
TAVILY_API_KEY=
LLM_ORDER=["groq","gemini"]

# Pagar kuota LLM untuk seluruh server (semua penyedia). Sesuaikan dengan paket API.
# Bila habis: klaim pakai heuristik, OCR dilewati, label tetap keluar.
LLM_MAX_PER_MINUTE=30
LLM_MAX_PER_DAY=5000
# Gemini free tier ±10/menit; 0 bila billing aktif.
GEMINI_RPM=10

# --- HTTPS (docker-compose.https.yml) ---
# Domain yang mengarah ke server. Tanpa beli domain: <ip-server>.sslip.io
DOMAIN=

# --- Opsional ---
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=tinggi
RATE_LIMIT_PER_MINUTE=60
CLOSED_REPORT_RETENTION_DAYS=90
HTTP_PORT=80
